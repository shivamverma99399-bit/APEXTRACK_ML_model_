# Application Environment (development, staging, production)
APP_ENV=development

# API Settings
API_V1_PREFIX=/api/v1

# Hugging Face Model Hub Configuration
HF_MODEL_ID=yuvrajengines/apextrack-track-condition-v2
MODEL_PATH=
HF_TOKEN=

# Temporal Track Condition & Telemetry History Configuration
TREND_MIN_CONFIDENCE=0.55
MAX_HISTORY=20

# Upload Settings
MAX_IMAGE_SIZE_MB=10

# CORS Configuration (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Development/Testing Mock Predictor (default: false)
ENABLE_MOCK_PREDICTOR=false
